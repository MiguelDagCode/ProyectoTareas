@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administrar Tarea</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/Estilos/EstilosAdministrar.css" rel="stylesheet" />

</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index","Index")">Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Registrar","Registrar")">Registrar Tareas</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Consultar","Consultar")">Consultar Tareas</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Administrar","Administrar")">Administrar Tareas</a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="container">
        <h2>Administrar Tarea</h2>
        <form method="post">
            <div class="row mt-4 align-items-center">
                <div class="col-auto">
                    <h4>Titulo</h4>
                </div>
                <div class="col-auto">
                    <input type="text" class="form-control" name="txtTitulo" placeholder="Ingrese el Titulo">
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-custom">Filtrar</button>
                </div>
            </div>
        </form>
        @if (ViewBag.ListaTareasBuscados != null && ViewBag.ListaTareasBuscados.Count > 0)
        {
            <table class="table table-striped mt-4">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Titulo</th>
                        <th>Descripcion</th>
                        <th>Fecha Limite</th>
                        <th>Estado</th>
                        <th>Prioridad</th>
                        <th>Categoria</th>
                        <th>Fecha de Creacion</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tarea in ViewBag.ListaTareasBuscados)
                    {
                        <tr>
                            <td>@tarea.Id</td>
                            <td>@tarea.Titulo</td>
                            <td>@tarea.Descripcion</td>
                            <td>@tarea.FechaLimite</td>
                            <td>@tarea.EstadoId.Nombre</td>
                            <td>@tarea.PrioridadId.Nombre</td>
                            <td>@tarea.CategoriaId.Nombre</td>
                            <td>@tarea.FechaCreacion</td>
                            <td>
                                <a href="@Url.Action("Editar", "Administrar", new { id = tarea.Id })" class="btn btn-edit btn-sm">EDITAR</a>
                                <form method="post" action="@Url.Action("Eliminar", "Administrar")" style="display:inline;">
                                    <input type="hidden" name="id" value="@tarea.Id" />
                                    <button type="submit" class="btn btn-delete btn-sm" onclick="return confirm('¿Estás seguro de eliminar esta tarea?');">ELIMINAR</button>
                                </form>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="alert alert-warning">@ViewBag.Mensaje</p>
        }
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-info">
                @TempData["Mensaje"]
            </div>
        }

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>



