@model ProyectoTareas.Models.ViewModels.EditarTareaViewModel

@{
    ViewBag.Title = "Editar Tarea";
}

<!DOCTYPE html>
<html lang="es-pe">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Intranet - Editar Tarea</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/Estilos/EditarEstilos.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <h2>Editar Tarea</h2>

        <form method="post">
            <input type="hidden" name="txtIdTarea" value="@Model.Tarea.Id" />

            <div class="mb-3">
                <label for="Titulo" class="form-label">Título</label>
                <input type="text" class="form-control" name="txtTitulo" value="@Model.Tarea.Titulo" required>
            </div>

            <div class="mb-3">
                <label for="Descripcion" class="form-label">Descripción</label>
                <textarea class="form-control" name="txtDescripcion" required>@Model.Tarea.Descripcion</textarea>
            </div>

            <div class="mb-3">
                <label for="FechaLimite" class="form-label">Fecha Límite</label>
                <input type="date" class="form-control" name="dateFechaLimite"
                       value="@Model.Tarea.FechaLimite.ToString("yyyy-MM-dd")" required>
            </div>

            <div class="mb-3">
                <label for="cmbEstadoId" class="form-label">Estado</label>
                <select class="form-select" name="cmbEstadoId" required>
                    <option value="" disabled selected>Seleccionar Estado</option>
                    @foreach (var estado in Model.Estados)
                    {
                        <option value="@estado.Id">@estado.Nombre</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label for="cmbPrioridadId" class="form-label">Prioridad</label>
                <select class="form-select" name="cmbPrioridadId" required>
                    <option value="" disabled selected>Seleccionar Prioridad</option>
                    @foreach (var prioridad in Model.Prioridades)
                    {
                        <option value="@prioridad.Id">@prioridad.Nombre</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label for="cmbCategoriaId" class="form-label">Categoría</label>
                <select class="form-select" name="cmbCategoriaId" required>
                    <option value="" disabled selected>Seleccionar Categoría</option>
                    @foreach (var categoria in Model.Categorias)
                    {
                        <option value="@categoria.Id">@categoria.Nombre</option>
                    }
                </select>
            </div>


            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            <a href="@Url.Action("Administrar", "Administrar")" class="btn btn-secondary">Cancelar</a>
        </form>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-info">
                @TempData["Mensaje"]
            </div>
        }
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
   

</html>
