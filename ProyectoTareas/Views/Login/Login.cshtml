@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es-pe">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Intranet - Iniciar Sesión</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/Estilos/Estilos.css" rel="stylesheet" />
</head>
<body>
    
        <div class="container d-flex justify-content-center align-items-center">
            <div class="text-center me-5">
                <img src="~/Imagenes/logo.png" alt="Cibertec_Logo" width="150">
                <h3 class="mt-3 fw-bold">Intranet</h3>
                <h4 class="fw-bold">Iniciar Sesión</h4>
                <p class="text-muted">Administrador de Tareas</p>
            </div>

            <div class="login-container">
                <h5 class="fw-bold">Ingrese su Email y Contraseña</h5>
                @if (!string.IsNullOrEmpty(ViewBag.Mensaje))
                {
                    <div class="alert alert-danger">@ViewBag.Mensaje</div>
                }
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="text" class="form-control" name="txtEmail" required placeholder="Ingrese su email">
                    </div>


                    <div class="mb-3">
                        <label class="form-label">CONTRASEÑA</label>
                        <input type="password" class="form-control" name="txtContrasena" required placeholder="Ingrese su contraseña">
                    </div>
                    <button type="submit" class="btn btn-light w-100">Iniciar Sesión </button>
                </form>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
</body>
</html>
